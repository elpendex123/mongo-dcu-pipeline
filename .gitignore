# Terraform
.terraform/
# .terraform.lock.hcl is deliberately NOT ignored - it pins provider
# versions so every apply resolves the same ones.
*.tfstate
*.tfstate.*
*.tfvars
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Secrets / local config
.env
.env.*
!.env.example
kubeconfig*
*.pem
*.key

# Ansible
*.retry

# Runtime output
logs/
*.log

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
