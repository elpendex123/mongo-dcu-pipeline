# Generated by ansible/playbooks/deploy-monitoring.yml - do not edit.
# The registry host, the IAM role and the region are facts of this account and
# this apply; everything chosen rather than assigned is in helm/monitoring/values.yaml.

global:
  imageRegistry: {{ aws_account_id }}.dkr.ecr.{{ aws_region }}.amazonaws.com/{{ project }}-mirror

prometheus:
  prometheusSpec:
    externalLabels:
      environment: {{ target_env }}
      cluster: {{ cluster_name }}

grafana:
  serviceAccount:
    annotations:
      eks.amazonaws.com/role-arn: {{ tf_env.grafana_role_arn }}
      eks.amazonaws.com/sts-regional-endpoints: "true"
  env:
    # Both names. Grafana's AWS SDK reads AWS_REGION; anything botocore-based
    # reads only AWS_DEFAULT_REGION - and a client with no region falls back to
    # a global endpoint this VPC cannot reach (issue 17).
    AWS_REGION: {{ aws_region }}
    AWS_DEFAULT_REGION: {{ aws_region }}
  additionalDataSources:
    - name: CloudWatch
      uid: cloudwatch
      type: cloudwatch
      access: proxy
      editable: false
      jsonData:
        # The SDK's default chain, which finds the IRSA web identity token.
        authType: default
        defaultRegion: {{ aws_region }}
