# Generated by ansible/playbooks/render-values.yml - do not edit.
# Endpoints, ARNs and the image tag change on every apply; rerun the playbook
# rather than editing this file.

environment: {{ target_env }}
namespace: {{ app_namespace }}

image:
  repository: {{ image_repository }}
  tag: "{{ image_ref_tag }}"

serviceAccount:
  # Created by playbooks/service-account.yml and bound to the role below. The
  # chart uses it; it does not create it.
  create: false
  name: {{ app_service_account }}
  roleArn: {{ tf_env.irsa_role_arn }}

# Non-secret configuration, keyed as app/config.py reads it.
config:
{% for key, value in tf_env.app_config | dictsort %}
  {{ key }}: "{{ value }}"
{% endfor %}
  SES_ENABLED: "{{ ses_enabled | string | lower }}"

# Kubernetes Secrets created by playbooks/secrets-bridge.yml, mounted with envFrom.
secretRefs:
  - {{ k8s_secret_docdb }}
  - {{ k8s_secret_rds }}
  - {{ k8s_secret_ses }}

# For reference only. The application reads these from the Secrets above.
endpoints:
  documentdb: {{ tf_env.documentdb_endpoint }}
  mysql: {{ tf_data.rds_address }}
