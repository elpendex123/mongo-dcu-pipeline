# Local development configuration.
#
#   cp .env.example .env
#
# The bucket names come straight from Terraform, so nothing has to be typed:
#
#   terraform -chdir=terraform/environments/dev output -raw env_file_lines
#
# docker-compose.yml sets the database and MongoDB values itself, since those
# point at containers on the compose network.

# --- Container user -------------------------------------------------------
# The uid the application runs as locally. It must match the host user, because
# the container reads the host's ~/.aws (mode 0600) and writes to ./logs.
# Check with: id -u && id -g
APP_UID=1000
APP_GID=1000

# --- AWS ------------------------------------------------------------------
AWS_REGION=us-east-1
# The profile in ~/.aws/credentials to use. Leave unset for the default.
# AWS_PROFILE=default

# --- S3 buckets (real, even in local development) --------------------------
S3_INPUT_BUCKET=mongo-dcu-pipeline-dev-input-950639281723
S3_SUCCESSFUL_BUCKET=mongo-dcu-pipeline-dev-successful-950639281723
S3_FAILED_BUCKET=mongo-dcu-pipeline-dev-failed-950639281723
S3_REPORTS_JSON_BUCKET=mongo-dcu-pipeline-dev-reports-json-950639281723
S3_REPORTS_LOG_BUCKET=mongo-dcu-pipeline-dev-reports-log-950639281723

# --- Behaviour ------------------------------------------------------------
APP_ENV=dev
POLL_INTERVAL_SECONDS=20
LOG_LEVEL=INFO

# --- Metrics --------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PORT=9090

# --- Email ----------------------------------------------------------------
# Off locally: the run summary is written to the log instead.
SES_ENABLED=false
# SES_SENDER=pipeline@example.com
# SES_RECIPIENTS=you@example.com,someone@example.com
